# Leave blank for a live build without database access.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Only digits, no plus sign. Minimum 8, maximum 15 digits, first digit nonzero.
AOF_WHATSAPP_NUMBER=

# Owner-confirmed public campus address. This is intentionally blank.
AOF_CAMPUS_ADDRESS=

# Set to true only for a local or non-production preview catalogue.
AOF_DEMO_MODE=false
